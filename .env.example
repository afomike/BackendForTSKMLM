# Backend Environment Configuration
# Copy this file to .env and update the values

# Database configuration
# Use DATABASE_URL for local development or NEON_DATABASE_URL for production/Neon.
DATABASE_URL=postgresql://user:password@localhost:5432/tskmlm_dev
NEON_DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Session/JWT secret (generate a strong random string)
SESSION_SECRET=your-secret-key-here-min-64-characters-recommended

# Node environment
NODE_ENV=development

# Cloudinary (if using file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_FOLDER=your-upload-folder

# Server configuration
PORT=10000

# CORS configuration (frontend URL)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# creating admin user 
# npm run create-admin -- --email admin@example.com --password "admin123" --fullname "Admin Name"  

#  deleting admin user
# npm run delete-admin -- --email admin@example.com
